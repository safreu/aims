  "query": "\n            SELECT\n                h.id,\n                h.name,\n                h.kind,\n                h.personal_owner_id,\n                h.created_at,\n                h.updated_at\n            FROM households h\n            JOIN household_members hm ON hm.household_id = h.id\n            WHERE hm.user_id = $1\n            ",
